# Puertos publicados en la máquina host
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432

# Sesiones locales. En desarrollo, vacío genera una clave efímera al iniciar.
# En producción debe contener al menos 32 caracteres (por ejemplo: openssl rand -hex 32).
APP_ENV=development
SESSION_SECRET=

# Base de datos local de RescueSync
POSTGRES_DB=rescuesync
POSTGRES_USER=rescuesync
POSTGRES_PASSWORD=rescuesync_dev

# Bonita Runtime 10.4 ejecutado por Docker Compose
BONITA_BASE_URL=http://bonita:8080/bonita
BONITA_PORT=8080
BONITA_USERNAME=install
BONITA_PASSWORD=install
# Contraseña local para crear los usuarios referenciados por actorMapping.xml.
# Si queda vacía, bonita-deploy genera una aleatoria y no la registra.
BONITA_ACTOR_PASSWORD=
BONITA_PLATFORM_USERNAME=platformAdmin
BONITA_PLATFORM_PASSWORD=platform
BONITA_MONITORING_USERNAME=monitoring
BONITA_MONITORING_PASSWORD=monitoring_dev
# El servicio bonita-deploy busca este nombre y versión dentro del archivo .bar.
BONITA_PROCESS_NAME=RescueSync
BONITA_PROCESS_VERSION=1.1
BONITA_STARTUP_TIMEOUT_SECONDS=300
BONITA_REQUEST_TIMEOUT_SECONDS=30
BONITA_BACKEND_BASE_URL=http://backend:8000
BONITA_NATIONAL_API_BASE_URL=http://national-api:8000
BONITA_OFFER_WINDOW_MS=7200000
BONITA_CONNECT_TIMEOUT_MS=5000
BONITA_READ_TIMEOUT_MS=30000
# Timeouts de FastAPI hacia la API REST de Bonita. El ID de la definición no se
# configura: el backend lo resuelve por nombre y versión en cada ambiente.
BONITA_CLIENT_CONNECT_TIMEOUT_SECONDS=3
BONITA_CLIENT_READ_TIMEOUT_SECONDS=10

# PostgreSQL interno utilizado exclusivamente por Bonita
BONITA_DB_NAME=bonita
BONITA_DB_USER=bonita
BONITA_DB_PASS=bpm
BONITA_BIZ_DB_NAME=business_data
BONITA_BIZ_DB_USER=business_data
BONITA_BIZ_DB_PASS=bpm

# URL pública que utiliza el navegador para alcanzar FastAPI en desarrollo.
VITE_API_URL=http://localhost:8000/api/v1
