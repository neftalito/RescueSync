# Puertos publicados en la máquina host
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025

# Sesiones locales. En desarrollo, vacío genera una clave efímera al iniciar.
# En producción debe contener al menos 32 caracteres (por ejemplo: openssl rand -hex 32).
APP_ENV=development
SESSION_SECRET=
# Orígenes exactos admitidos por CORS y por el WebSocket. Para una demo detrás
# de Cloudflare, agregar también http://localhost:4173 y la URL HTTPS del túnel.
CORS_ORIGINS=["http://localhost:5173"]

# Administrador inicial de RescueSync. Se crea en PostgreSQL y en Bonita con las
# mismas credenciales; en Bonita recibe el perfil predeterminado Administrator.
# Debe reemplazar su contraseña local en el primer ingreso.
# En producción se deben sobreescribir ambos valores antes del primer arranque;
# el backend rechaza la contraseña pública de desarrollo en ese entorno.
ADMIN_EMAIL=admin@rescuesync.org
ADMIN_INITIAL_PASSWORD=administrador123

# Correo transaccional. Compose usa Mailpit para capturar mensajes localmente.
# Para Mailtrap, reemplazar host, puerto y credenciales con los del sandbox y
# activar STARTTLS según su configuración. No versionar credenciales reales.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SENDER_EMAIL=no-reply@rescuesync.org
SMTP_TIMEOUT_SECONDS=10
FRONTEND_PUBLIC_URL=http://localhost:5173

# Base de datos local de RescueSync
POSTGRES_DB=rescuesync
POSTGRES_USER=rescuesync
POSTGRES_PASSWORD=rescuesync_dev

# Bonita Runtime 10.4 ejecutado por Docker Compose
BONITA_BASE_URL=http://bonita:8080/bonita
BONITA_PORT=8080
BONITA_USERNAME=install
BONITA_PASSWORD=install
# Contraseña local para crear los usuarios referenciados por actorMapping.xml.
# Si queda vacía, bonita-deploy genera una aleatoria y no la registra.
BONITA_ACTOR_PASSWORD=
BONITA_PLATFORM_USERNAME=platformAdmin
BONITA_PLATFORM_PASSWORD=platform
BONITA_MONITORING_USERNAME=monitoring
BONITA_MONITORING_PASSWORD=monitoring_dev
# El servicio bonita-deploy busca este nombre y versión dentro del archivo .bar.
BONITA_PROCESS_NAME=RescueSync
BONITA_PROCESS_VERSION=1.2
# Token que Bonita envía como "Authorization: Bearer" en sus callbacks a FastAPI.
# Mínimo 32 caracteres. Este valor sirve solo para desarrollo; en producción se
# genera con: openssl rand -hex 32. Se aplica al instalar el proceso: cambiarlo
# después requiere recrear los volúmenes de Bonita (ver README).
BONITA_CALLBACK_TOKEN=dev-only-rescuesync-bonita-callback-token
BONITA_STARTUP_TIMEOUT_SECONDS=300
BONITA_REQUEST_TIMEOUT_SECONDS=30
# Parámetros del proceso: se inyectan en el .bar al instalarlo. Cambiarlos
# después no modifica un proceso ya desplegado (bonita-deploy lo advierte).
BONITA_BACKEND_BASE_URL=http://backend:8000
BONITA_NATIONAL_API_BASE_URL=http://national-api:8000
BONITA_OFFER_WINDOW_MS=7200000
BONITA_CONNECT_TIMEOUT_MS=5000
BONITA_READ_TIMEOUT_MS=30000
# Timeouts de FastAPI hacia la API REST de Bonita. La definición se resuelve
# siempre por BONITA_PROCESS_NAME y BONITA_PROCESS_VERSION.
BONITA_CLIENT_CONNECT_TIMEOUT_SECONDS=3
BONITA_CLIENT_READ_TIMEOUT_SECONDS=10

# PostgreSQL interno utilizado exclusivamente por Bonita
BONITA_DB_NAME=bonita
BONITA_DB_USER=bonita
BONITA_DB_PASS=bpm
BONITA_BIZ_DB_NAME=business_data
BONITA_BIZ_DB_USER=business_data
BONITA_BIZ_DB_PASS=bpm

# URL pública que utiliza el navegador para alcanzar FastAPI en desarrollo.
VITE_API_URL=http://localhost:8000/api/v1
# Adaptador de inventario nacional (desde el contenedor del backend local).
NACIONAL_BASE_URL=http://host.docker.internal:8001/api/v1
NACIONAL_TIMEOUT_SECONDS=10
NACIONAL_SISTEMA_ORIGEN=
# Cuenta del catálogo: INTEGRACION o ADMIN_NACIONAL para consultar;
# crear capacidades desde administración exige ADMIN_NACIONAL.
NACIONAL_CATALOGO_LOGIN=admin.nacional.demo@rescuesync.org
NACIONAL_CATALOGO_PASSWORD=admin-nacional-demo123

# Clave Fernet independiente para credenciales y JWT institucionales por ONG.
# Generar fuera del repositorio: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Mantenerla estable y compartida entre workers. Vacía: acceso nacional sin configurar.
# Obligatoria también para ejecutar el seed y preparar el acceso nacional demo.
NACIONAL_ENCRYPTION_KEY=

# Cuenta INTEGRACION del emisor local; configuración única para el alta automática.
NACIONAL_APROVISIONAMIENTO_LOGIN=
NACIONAL_APROVISIONAMIENTO_PASSWORD=
